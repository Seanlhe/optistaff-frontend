{
  "name": "optistaff-main",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:frontend:run && npm run test:backend:run",
    "test:watch": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest --config vitest.frontend.config.ts",
    "test:frontend:run": "vitest run --config vitest.frontend.config.ts",
    "test:frontend:ui": "vitest --ui --config vitest.frontend.config.ts",
    "test:frontend:coverage": "vitest run --coverage --config vitest.frontend.config.ts",
    "test:frontend:unit": "vitest --config vitest.frontend.config.ts tests/frontendunit/",
    "test:frontend:unit:run": "vitest run --config vitest.frontend.config.ts tests/frontendunit/",
    "test:frontend:unit:ui": "vitest --ui --config vitest.frontend.config.ts tests/frontendunit/",
    "test:frontend:unit:coverage": "vitest run --coverage --config vitest.frontend.config.ts tests/frontendunit/",
    "test:backend": "supabase start && vitest --config vitest.backend.config.ts",
    "test:backend:run": "supabase start && vitest run --config vitest.backend.config.ts",
    "test:db-functions": "supabase start && vitest run --config vitest.backend.config.ts tests/unit/create-default-preferences.test.ts tests/unit/upsert-user-preferences.test.ts tests/unit/validate-job-names.test.ts tests/unit/get-user-location.test.ts",
    "test:db-functions:ui": "supabase start && vitest --ui --config vitest.backend.config.ts tests/unit/create-default-preferences.test.ts tests/unit/upsert-user-preferences.test.ts tests/unit/validate-job-names.test.ts tests/unit/get-user-location.test.ts",
    "test:backend:ui": "supabase start && vitest --ui --config vitest.backend.config.ts",
    "test:backend:coverage": "supabase start && vitest run --coverage --config vitest.backend.config.ts",
    "test:backend:watch": "supabase start && vitest --watch --config vitest.backend.config.ts",
    "test:preferences": "supabase start && vitest run --config vitest.backend.config.ts tests/unit/preferences-validation.test.ts tests/integration/usePreferences-simple.test.tsx",
    "test:pure": "vitest run --config vitest.pure.config.ts tests/unit",
    "test:pure:watch": "vitest --config vitest.pure.config.ts tests/unit",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.2.0",
    "@mui/x-charts": "^8.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.50.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.56.2",
    "@types/react-datepicker": "^6.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-datepicker": "^8.4.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "shadcn": "^2.9.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-day-picker": "^5.2.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "cypress": "^14.5.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "supabase": "^2.33.9",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4"
  }
}
