{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vitest/globals"],

    /* Bundler mode */
    "moduleResolution": "node",
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": ["src", "vitest.config.ts", "tests/frontendSuccessUnit/Calendar.test.tsx", "tests/frontendSuccessUnit/CalendarEvent.test.tsx", "tests/frontendSuccessUnit/LocationAwareMap.test.tsx", "tests/frontendSuccessUnit/PreferencesForm.test.tsx", "tests/frontendSuccessUnit/PreferencesJobType.test.tsx", "tests/frontendSuccessUnit/PreferencesMaximum.test.tsx", "tests/frontendSuccessUnit/PreferencesPay.test.tsx", "tests/frontendSuccessUnit/JSPref.test.tsx"]
}
